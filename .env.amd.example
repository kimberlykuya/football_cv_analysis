# AMD MI300X deployment template.
# Copy values into your shell with:
#   set -a && source .env.amd.example && set +a

DEEPSEEK_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_API_KEY=<rotated-key>
DEEPSEEK_MODEL=deepseek-ai/DeepSeek-V4-Pro
ALLOW_MOCK_LLM=false
ALLOW_CPU_FALLBACK=false

YOLO_MODEL_PATH=yolo26x.pt
YOLO_BATCH_SIZE=64
YOLO_IMGSZ=640
YOLO_HALF=true
EMBED_BATCH_SIZE=256

BACKEND_URL=http://127.0.0.1:8001
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001

# Use either a bare IP or full origin. Multiple values are comma-separated.
NEXT_ALLOWED_DEV_ORIGINS=<gpu-public-ip>,http://<gpu-public-ip>:3000

PYTHON_BIN=python3.11
ROCM_TORCH_INDEX=https://download.pytorch.org/whl/rocm7.0

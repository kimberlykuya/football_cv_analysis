# AMD MI300X deployment template.
# Copy values into your shell with:
#   set -a && source .env.amd.example && set +a

DEEPSEEK_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_API_KEY=""
DEEPSEEK_MODEL=deepseek-ai/DeepSeek-V4-Pro
ALLOW_MOCK_LLM=false
ALLOW_CPU_FALLBACK=false

QWEN_VALIDATION_ENABLED=false
QWEN_BASE_URL=https://api.featherless.ai/v1
QWEN_API_KEY=
QWEN_MODEL=Qwen/Qwen3-235B-A22B
QWEN_MAX_TOKENS=2048

VLM_ENABLED=true
ALLOW_VLM_FALLBACK=true
VLM_MOCK=false
VLM_MODEL=Qwen/Qwen3-VL-8B-Instruct
VLM_DEVICE=cuda
VLM_DTYPE=bfloat16
VLM_MAX_EVENT_FRAMES=40
VLM_MAX_NEW_TOKENS=512
VLM_FRAME_WINDOW_SEC=1.0
VLM_IMAGE_DIR=./uploads/vlm_frames
HF_HOME=./.hf_cache

YOLO_MODEL_PATH=yolo26x.pt
YOLO_BATCH_SIZE=64
YOLO_IMGSZ=640
YOLO_HALF=true
EMBED_BATCH_SIZE=256

BACKEND_URL=http://127.0.0.1:8001
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001

# Use either a bare IP or full origin. Multiple values are comma-separated.
NEXT_ALLOWED_DEV_ORIGINS=""

PYTHON_BIN=
ROCM_TORCH_INDEX=https://download.pytorch.org/whl/rocm7.0
